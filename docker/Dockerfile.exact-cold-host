# Add exact-sized cold host owners to the already public image6 runtime.
# No model, target head, kernel, or library changes.
ARG BASE_IMAGE=sha256:2e50016cfcc9cd22f15d3f69ccf001e4877236e12ebb4ab458cc9c16caaef9e3
FROM ${BASE_IMAGE}
ARG R9V_REVISION=unknown
COPY runtimes/qwen38-flash-next-gfx1201-v1/retained-mtp4/python/vllm_gguf_plugin/quantization/params.py /opt/r9v/retained-mtp4/python/vllm_gguf_plugin/quantization/params.py
COPY runtimes/qwen38-flash-next-gfx1201-v1/retained-mtp4/python/vllm_gguf_plugin/quantization/tiered_experts.py /opt/r9v/retained-mtp4/python/vllm_gguf_plugin/quantization/tiered_experts.py
COPY runtimes/qwen38-flash-next-gfx1201-v1/retained-mtp4/python/vllm_gguf_plugin/quantization/params.py /opt/r9v/lib/python3.12/site-packages/vllm_gguf_plugin/quantization/params.py
COPY runtimes/qwen38-flash-next-gfx1201-v1/retained-mtp4/python/vllm_gguf_plugin/quantization/tiered_experts.py /opt/r9v/lib/python3.12/site-packages/vllm_gguf_plugin/quantization/tiered_experts.py
LABEL org.opencontainers.image.source="https://github.com/Dyluhn/R9V" \
      org.opencontainers.image.revision="${R9V_REVISION}" \
      org.opencontainers.image.description="Experimental exact-sized streaming cold host owners; qualification required"
