# System-One deployment: published WMMA runtime with the retained chat limits.
# This is a local qualification profile, not upstream's 128K/MTP4 profile.
: "${R9V_IMAGE:=sha256:2dac17a215fb5b0e3461e4c3e36a2981eec8ac3d6021e73183d247e819740c03}"
: "${R9V_MAX_MODEL_LEN:=262144}"
: "${R9V_MTP_SPEC_TOKENS:=2}"
: "${R9V_ENABLE_PREFIX_CACHING:=1}"
: "${R9V_TIERED_PREFILL_GROUP_SIZE:=32}"
# Keep prompt chunks bounded while qualifying the existing memory placement.
: "${R9V_MAX_NUM_BATCHED_TOKENS:=1024}"
r9v_systemone_profile_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)
source "$r9v_systemone_profile_root/profiles/qwen38-flash-next/dual-r9700/profile.env"
unset r9v_systemone_profile_root
